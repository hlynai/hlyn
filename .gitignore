__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# Rust build output. The .so this ships is built by the packaging step, not
# committed source.
native/target/
native/fuzz/target/

# The shim is copied here at build time so it ships inside the wheel. It is a
# build artifact, not source.
src/hlyn/core/libhlyn.so

# Wheels and sdists.
dist/
build/

# Mutation-testing output. Regenerated by tools/mutate.sh on every run; a
# result worth keeping belongs in a commit message or a test, not here.
native/mutants.out/
native/mutants.out.old/

# Fuzzing artifacts. The corpus is machine-generated and grows without bound;
# a crashing input worth keeping belongs in the test suite as a named case,
# not here.
native/fuzz/corpus/
native/fuzz/artifacts/
native/fuzz/coverage/

.venv/
venv/
