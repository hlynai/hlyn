# Test bed for the Linux backend with the native crates built from source:
# Rust to build libhlyn.so and libhlyn_report.so, Python to run the suite.
# Used by tools/linuxtest.sh. Nothing here is part of the shipped package.
FROM rust:slim
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends python3 python3-pytest python3-hypothesis \
      python3-urllib3 python3-aiohttp \
      libseccomp2 libseccomp-dev gcc libc6-dev iproute2 procps curl ca-certificates \
      git nodejs npm \
 && rm -rf /var/lib/apt/lists/*
# The real Claude Code, for tests/test_claude.py (`hlyn claude` against a
# scripted model). Pinned, so a run is reproducible; raise it on purpose:
# `npm view @anthropic-ai/claude-code dist-tags`, then tests/test_claude.py
# against the new one. Checked 2026-10-01: `latest` is 2.1.286 (this pin);
# 2.1.287 (`next`) passed the same 12 tests, 2.1.285 is `stable`.
RUN npm install -g --no-fund --no-audit @anthropic-ai/claude-code@2.1.286
